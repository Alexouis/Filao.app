# Réécriture SPA — Apache
#
# L'application est une SPA : ses routes (`/invitation/<token>`,
# `/collaborator-access`, `/reset-password`, `/register`) n'existent pas sous
# forme de fichiers. Apache cherche un fichier physique à ce chemin et renvoie
# 404, ce qui rend la page d'acceptation d'invitation inatteignable — le lien
# reçu par e-mail ne mène nulle part.
#
# Ce fichier doit se trouver à la racine servie (à côté d'`index.html`). Vite
# recopie tel quel le contenu de `public/` dans `dist/` au build.
#
# ⚠️ Apache n'applique un `.htaccess` que si la directive `AllowOverride All`
#    est active pour ce répertoire. Sans elle, le fichier est ignoré en silence
#    et le 404 persiste.

# `FallbackResource` d'abord : une seule directive, et elle ne s'applique qu'aux
# requêtes ne correspondant à aucun fichier existant — les assets sont servis
# normalement sans condition supplémentaire à écrire.
<IfModule mod_dir.c>
  FallbackResource /index.html
</IfModule>

# Repli sur mod_rewrite si mod_dir est absent ou si `FallbackResource` n'est pas
# autorisé par la configuration du serveur.
<IfModule !mod_dir.c>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Les requêtes vers un fichier ou un dossier réellement présent sont servies
  # telles quelles : sans ces deux conditions, les assets JS, CSS et images
  # renverraient eux aussi index.html.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste est confié au routeur côté client.
  RewriteRule ^ index.html [L]
</IfModule>
</IfModule>

# Ni mod_dir ni mod_rewrite : on renvoie au moins index.html sur les 404, le
# routeur prend alors le relais — au prix d'un statut HTTP incorrect.
<IfModule !mod_dir.c>
<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>
</IfModule>

# Le vrai 404 applicatif est rendu par le routeur : il ne connaît qu'une liste
# fermée de chemins et affiche une page d'erreur Filao pour tout le reste.
# Apache ne peut pas faire ce tri — il ne distingue pas une route de
# l'application d'une faute de frappe.

<IfModule mod_headers.c>
  # index.html ne doit jamais être mis en cache : il référence les bundles par
  # empreinte, une version périmée pointerait vers des fichiers supprimés.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Les bundles portent une empreinte dans leur nom : ils sont immuables.
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>