# Configuration des tests de cloisonnement (copie à renommer en
# tests/cloisonnement.env — NE PAS COMMITER le fichier renseigné).

# Projet Supabase visé. Utiliser une PRÉPRODUCTION, jamais la production :
# le script se connecte avec de vrais comptes.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Deux comptes de test appartenant à DEUX entreprises différentes.
C1_EMAIL=
C1_PASSWORD=
C2_EMAIL=
C2_PASSWORD=

# Un dossier créé par chaque compte (identifiants UUID).
# C'est sur ces identifiants que portent les tests d'accès croisé.
C1_AO_ID=
C2_AO_ID=

# Optionnel — jetons d'invitation pour les tests C7 et C8.
# TOKEN_TIERS : un jeton valide destiné à quelqu'un d'autre.
# TOKEN_EXPIRE : un jeton dont la date d'expiration est dépassée.
TOKEN_TIERS=
TOKEN_EXPIRE=
